# Supabase browser configuration. The publishable/anon key is intended for browser use;
# keep Row Level Security enabled and never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Cloudflare R2 server-side credentials (for the Next.js upload-signing route).
# Never prefix these with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional server-only service key. Not needed by the current browser/RLS integration.
# Only add this to Vercel if a trusted server route needs admin operations.
SUPABASE_SERVICE_ROLE_KEY=
