import assert from "node:assert/strict";
const storage = new Map<string, string>();
(globalThis as any).window = globalThis;
(globalThis as any).localStorage = { getItem: (key: string) => storage.get(key) ?? null, setItem: (key: string, value: string) => storage.set(key, value), removeItem: (key: string) => storage.delete(key) };
const store: any = await import("./lib/store.ts");
store.hydrate();
const original = { health: store.getState().health, money: store.getState().money, habits: store.getState().habits };
store.addLifeVision("places", "  Visit Kyoto  ", " Autumn ");
const entry = store.getState().lifeVision[0];
assert.equal(entry.title, "Visit Kyoto");
assert.equal(entry.notes, "Autumn");
store.updateLifeVision(entry.id, { done: true, title: "Visit Japan" });
assert.equal(store.getState().lifeVision[0].done, true);
assert.equal(JSON.parse(storage.get("atlas.world.v1")!).lifeVision[0].title, "Visit Japan");
store.removeLifeVision(entry.id);
assert(!store.getState().lifeVision.some((item: any) => item.id === entry.id));
assert.deepEqual(store.getState().health, original.health);
assert.deepEqual(store.getState().money, original.money);
assert.deepEqual(store.getState().habits, original.habits);
console.log("Life vision persistence and previous-data preservation passed");
