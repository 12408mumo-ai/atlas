import assert from "node:assert/strict";
const storage = new Map<string, string>();
(globalThis as any).window = globalThis;
(globalThis as any).localStorage = { getItem: (key: string) => storage.get(key) ?? null, setItem: (key: string, value: string) => storage.set(key, value), removeItem: (key: string) => storage.delete(key) };
const store: any = await import("./lib/store.ts");
store.hydrate();
const { addProject, addProjectStep, addDeadline, addSubject, addStudySession, getState, removeProject, removeProjectStep, removeDeadline, removeSubject, removeStudySession, toggleTask, setState, todayISO } = store;

addProject("CRUD test project", "side tool");
const project = getState().projects.find((item) => item.name === "CRUD test project")!;
addProjectStep(project.id, "First step");
const step = getState().projects.find((item) => item.id === project.id)!.tasks[0];
assert.equal(step.title, "First step");
toggleTask(project.id, step.id);
assert.equal(getState().projects.find((item) => item.id === project.id)!.tasks[0].done, true);
removeProjectStep(project.id, step.id);
assert.equal(getState().projects.find((item) => item.id === project.id)!.tasks.length, 0);
const originalLedger = getState().ledger;
setState((s) => ({ hoursLogs: [...s.hoursLogs, { id: "test-linked", projectId: project.id, date: todayISO(), hours: 1 }, { id: "test-unlinked", projectId: "another-project", date: todayISO(), hours: 2 }] }));
removeProject(project.id);
assert(!getState().projects.some((item) => item.id === project.id));
assert(!getState().hoursLogs.some((item) => item.id === "test-linked"));
assert(getState().hoursLogs.some((item) => item.id === "test-unlinked"));
assert.deepEqual(getState().ledger, originalLedger);
addDeadline("CRUD deadline", "assignment", "Test", todayISO());
const deadline = getState().assignments.find((item) => item.title === "CRUD deadline")!;
removeDeadline(deadline.id);
assert(!getState().assignments.some((item) => item.id === deadline.id));
addSubject("CRUD subject", "school", "", 0, "");
const subject = getState().courses.find((item) => item.title === "CRUD subject")!;
addStudySession("CRUD subject", 3);
const session = getState().studySessions.find((item) => item.subject === "CRUD subject")!;
removeSubject(subject.id);
assert(getState().studySessions.some((item) => item.id === session.id), "Removing a subject must not delete study history");
removeStudySession(session.id);
assert(!getState().studySessions.some((item) => item.id === session.id));
assert(!JSON.parse(storage.get("atlas.world.v1")!).studySessions.some((item: any) => item.id === session.id));
console.log("Work CRUD: steps, cascade, independent history, and ledger preservation passed");
