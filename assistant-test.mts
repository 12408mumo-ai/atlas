import assert from "node:assert/strict";
const data = new Map<string, string>();
(globalThis as any).window = globalThis;
(globalThis as any).localStorage = { getItem: (key: string) => data.get(key) ?? null, setItem: (key: string, value: string) => data.set(key, value) };
const store = await import("./lib/store.ts");
const assistant = await import("./lib/assistant.ts");
store.hydrate();
assert.equal(assistant.destination("__proto__"), null);
assert.throws(() => assistant.parseAction({ type: "open", target: "https://evil.test" }));
assert.throws(() => assistant.parseAction({ type: "delete", category: "goals" }));
assert.throws(() => assistant.parseAction({ type: "add_life", category: "goals", title: "  " }));
let sent: any;
(globalThis as any).fetch = async (_url: string, options: any) => { sent = JSON.parse(options.body); return { ok: true, json: async () => ({ choices: [{ message: { content: JSON.stringify({ type: "add_life", category: "goals", title: "Learn guitar", notes: "" }) } }] }) }; };
const action = await assistant.interpret("Add learn guitar to goals", "test-key", "example/model");
assert.equal(store.getState().lifeVision.length, 0);
assert.equal(sent.messages[1].content, "Add learn guitar to goals");
assert(!JSON.stringify(sent).includes("atlas.world.v1"));
assert(action.type === "add_life" && assistant.applyAddition(action));
assert.equal(store.getState().lifeVision[0].title, "Learn guitar");
(globalThis as any).fetch = async () => ({ ok: false, status: 401 });
await assert.rejects(() => assistant.interpret("open life", "test", "model"), /401/);
await assert.rejects(() => assistant.interpret("open life", "", "model"), /API key/);
console.log("Assistant action validation, approval, request privacy and errors passed");
