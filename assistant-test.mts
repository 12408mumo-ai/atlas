import assert from "node:assert/strict";
const data = new Map<string, string>();
(globalThis as any).window = globalThis;
(globalThis as any).localStorage = { getItem: (key: string) => data.get(key) ?? null, setItem: (key: string, value: string) => data.set(key, value) };
const store = await import("./lib/store.ts");
const assistant = await import("./lib/assistant.ts");
store.hydrate();
assert.equal(assistant.destination("__proto__"), null);
assert.throws(() => assistant.parseAction({ type: "open", target: "https://evil.test" }));
assert.throws(() => assistant.parseAction({ type: "delete", category: "goals" }));
assert.throws(() => assistant.parseAction({ type: "add_life", category: "goals", title: "  " }));
assert.deepEqual(await assistant.interpretLocal("open Life"), { type: "open", target: "life" });
assert.deepEqual(await assistant.interpretLocal("show my things to do"), { type: "open", target: "things_to_do" });
const action = await assistant.interpretLocal("add Learn guitar to goals");
assert.equal(store.getState().lifeVision.length, 0);
assert(action.type === "add_life" && assistant.applyAddition(action));
assert.equal(store.getState().lifeVision[0].title, "Learn guitar");
assert.equal((await assistant.interpretLocal("delete all my goals")).type, "reply");
console.log("Local commands, validation and approval passed");

(globalThis as any).fetch = async () => ({ ok: true, status: 200, json: async () => ({ action: { type: "open", target: "life" } }) });
assert.deepEqual(await assistant.interpret("show me life"), { type: "open", target: "life" });
(globalThis as any).fetch = async () => ({ ok: true, status: 200, json: async () => ({ action: { type: "open", target: "https://evil.test" } }) });
await assert.rejects(() => assistant.interpret("open website"));
(globalThis as any).fetch = async () => ({ ok: false, status: 503 });
assert.deepEqual(await assistant.interpret("open Life"), { type: "open", target: "life" });
console.log("Gateway responses validated and local fallback passed");
